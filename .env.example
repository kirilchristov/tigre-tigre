# tigre tigre - Environment Variables
# Copy this file to .env.local for local development.
# Keep only keys the frontend runtime actually uses.

# ==============================================================================
# ANALYTICS (Optional)
# ==============================================================================

# Google Analytics Measurement ID (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel ID (optional)
# Defaults to the production pixel if omitted.
VITE_META_PIXEL_ID=1883344772853949


# ==============================================================================
# SHOPIFY CUSTOMER PRIVACY (Optional; all values are public)
# ==============================================================================

# Public Storefront API access token (Storefront API "public" token, never an
# Admin API token). Required only for the documented headless
# setTrackingConsent handoff. Supplied by the store owner.
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Root domains passed to the headless consent call.
VITE_SHOPIFY_CHECKOUT_ROOT_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ROOT_DOMAIN=

# Opt-in only: URL of the Shopify consent bundle to load when
# window.Shopify.customerPrivacy is not already present. Leave empty unless the
# installation has been validated; Shopify documents Hydrogen analytics as the
# supported custom-storefront path.
VITE_SHOPIFY_CONSENT_API_URL=

# Bounded wait for the consent callback before checkout proceeds (ms).
VITE_SHOPIFY_CONSENT_TIMEOUT_MS=1500

# ==============================================================================
# SOLD OUT MODE (Optional)
# ==============================================================================

# Set to 'true' to enable sold-out mode:
# - hides buy CTA cards
# - shows SOLD OUT stamp over the hero product image
VITE_SOLD_OUT_MODE=false

# Set to 'true' to enable staging mode (shows version info in console)
VITE_STAGING=false

# ==============================================================================
# NOTES
# ==============================================================================
# - All Vite environment variables must be prefixed with VITE_ to be exposed to the client
# - Never commit .env.local or .env files to git
# - In production (Vercel), set these in the dashboard under Settings > Environment Variables
