# tigre tigre - Environment Variables
# Copy this file to .env.local for local development.
# Keep only keys the frontend runtime actually uses.

# ==============================================================================
# SHOPIFY CHECKOUT CONFIGURATION
# ==============================================================================
# Use Shopify variant IDs for direct checkout links from the frontend.
# Example checkout URL shape:
# https://shop.tigre-tigre.com/cart/56986218955100:1

VITE_SHOPIFY_STOREFRONT_DOMAIN=shop.tigre-tigre.com
VITE_SHOPIFY_VARIANT_ID=56986218955100

# ==============================================================================
# ANALYTICS (Optional)
# ==============================================================================

# Google Analytics Measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# CONTACT (Optional)
# ==============================================================================

# Contact email for the site
VITE_CONTACT_EMAIL=hello@tigre-tigre.com

# ==============================================================================
# SOLD OUT MODE (Optional)
# ==============================================================================

# Set to 'true' to enable sold-out mode:
# - hides buy CTA cards
# - shows SOLD OUT stamp over the hero product image
VITE_SOLD_OUT_MODE=false

# Set to 'true' to enable staging mode (shows version info in console)
VITE_STAGING=false

# ==============================================================================
# NOTES
# ==============================================================================
# - All Vite environment variables must be prefixed with VITE_ to be exposed to the client
# - Never commit .env.local or .env files to git
# - In production (Vercel), set these in the dashboard under Settings > Environment Variables
