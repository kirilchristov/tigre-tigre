# tigre tigre - Environment Variables
# Copy this file to .env.local for local development

# ==============================================================================
# STRIPE CONFIGURATION
# ==============================================================================
# Payment Links - Create at: https://dashboard.stripe.com/payment-links
# These are all you need for simple checkout redirects

VITE_STRIPE_PAYMENT_LINK_SINGLE=https://buy.stripe.com/test_your_single_jar_link
VITE_STRIPE_PAYMENT_LINK_BUNDLE=https://buy.stripe.com/test_your_bundle_link

# Publishable Key - Only needed if using Stripe.js or Elements (optional)
# Get from: https://dashboard.stripe.com/apikeys
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ==============================================================================
# ANALYTICS (Optional)
# ==============================================================================

# Google Analytics Measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# CONTACT (Optional)
# ==============================================================================

# Contact email for the site
VITE_CONTACT_EMAIL=hello@tigre-tigre.com

# ==============================================================================
# SOLD OUT MODE (Optional)
# ==============================================================================

# Set to 'true' to enable sold-out mode:
# - hides buy CTA cards
# - hides selected homepage sections
# - shows SOLD OUT badge over the hero image
VITE_SOLD_OUT_MODE=false

# ==============================================================================
# APP VERSION (Optional - for staging environment)
# ==============================================================================

# App version to display in console (staging only)
VITE_APP_VERSION=0.0.1

# Set to 'true' to enable staging mode (shows version info in console)
VITE_STAGING=false

# ==============================================================================
# NOTES
# ==============================================================================
# - All Vite environment variables must be prefixed with VITE_ to be exposed to the client
# - Never commit .env.local or .env files to git
# - In production (Vercel), set these in the dashboard under Settings > Environment Variables
