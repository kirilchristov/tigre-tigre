# tigre tigre - Environment Variables
# Copy this file to .env.local for local development

# ==============================================================================
# STRIPE CONFIGURATION
# ==============================================================================
# Get your keys from: https://dashboard.stripe.com/apikeys

# Stripe Publishable Key (starts with pk_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Stripe Payment Links
# Create payment links at: https://dashboard.stripe.com/payment-links
VITE_STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_your_payment_link

# ==============================================================================
# ANALYTICS (Optional)
# ==============================================================================

# Google Analytics Measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ==============================================================================
# CONTACT (Optional)
# ==============================================================================

# Contact email for the site
VITE_CONTACT_EMAIL=hello@tigre-tigre.com

# ==============================================================================
# APP VERSION (Optional - for staging environment)
# ==============================================================================

# App version to display in console (staging only)
VITE_APP_VERSION=0.0.1

# Set to 'true' to enable staging mode (shows version info in console)
VITE_STAGING=false

# ==============================================================================
# NOTES
# ==============================================================================
# - All Vite environment variables must be prefixed with VITE_ to be exposed to the client
# - Never commit .env.local or .env files to git
# - In production (Vercel), set these in the dashboard under Settings > Environment Variables

